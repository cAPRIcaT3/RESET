# Local app server
PORT=3000

# Development fallback: prewritten fixture scenes.
RESET_SCENE_PROVIDER=fixture

# Gemma 3 4B via an OpenAI-compatible endpoint.
# GitHub Actions uses Ollama at 127.0.0.1:11434.
# RESET_SCENE_PROVIDER=openai_compat
# RESET_MODEL_URL=http://127.0.0.1:11434
# RESET_MODEL_NAME=gemma3:4b
# RESET_MODEL_API_KEY=ollama
# RESET_MODEL_TIMEOUT_MS=180000
# RESET_FEW_SHOT_COUNT=4
# RESET_MODEL_TEMPERATURE=1.05
# RESET_MODEL_TOP_P=0.92

# Daily pre-render compiler
# RESET_DAILY_COUNT=24
# RESET_DAILY_MAX_ATTEMPTS=140
# RESET_HISTORY_DAYS=30
# RESET_AUDIO_FORMAT=mp3
# RESET_PACK_DATE=2026-09-08

# Kokoro: local is the default. Browser is a development fallback.
# RESET_TTS_PROVIDER=local
# RESET_TTS_PROVIDER=browser
# RESET_KOKORO_URL=http://127.0.0.1:8880
