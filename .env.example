# Actions + Pages needs no VITE_ endpoints. These are optional live-development overrides.
# Optional PUBLIC endpoint URLs only. Every VITE_ variable is bundled into the browser.
# Keep API keys, provider authentication, validation, and rate limits on your own server.
VITE_GEMMA_ENDPOINT=
# `proxy` accepts the Kelna RESET payload; `openai` sends /v1/chat/completions.
VITE_GEMMA_PROTOCOL=proxy
VITE_GEMMA_MODEL=gemma4:e2b
VITE_GEMMA_TIMEOUT_MS=90000
VITE_KOKORO_ENDPOINT=
# Kokoro-compatible defaults: af_heart, mp3, speed 1.0.
VITE_KOKORO_MODEL=kokoro
VITE_KOKORO_VOICE=af_heart
VITE_KOKORO_FORMAT=mp3
VITE_KOKORO_SPEED=1
VITE_KOKORO_TIMEOUT_MS=15000
