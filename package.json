{
  "name": "kelnas-reset",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "moments:generate": "node --experimental-strip-types scripts/generate-moments.ts",
    "moments:verify": "node --experimental-strip-types scripts/verify-moments.ts",
    "moments:render": "npm run moments:generate && npm run moments:verify",
    "test:runtime": "RESET_RUNTIME_ONLY=1 npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "kokoro-js": "^1.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
